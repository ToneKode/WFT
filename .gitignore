# Build directories
build/
cmake-build-*/
out/

# CMake presets write per-preset trees under build/, already ignored above.
CMakeUserPresets.json

# Compiled binaries
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# Object files
*.o
*.obj
*.slo
*.lo

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
Makefile
# Only generated CMake output is ignored here. Do not add `*.cmake` — the
# repo's own modules under cmake/ would be silently excluded from the build.
!CMakeLists.txt

# IDE and editor files
.vscode/
.vs/
.idea/
*.swp
*.swo
*~
.DS_Store

# Visual Studio
*.user
*.suo
*.pdb
*.ilk
*.log
[Dd]ebug/
[Rr]elease/

# Scratch and temporary files
*.tmp
*.temp

# vcpkg
vcpkg_installed/
